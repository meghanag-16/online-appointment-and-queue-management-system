# Copy this file to .env and adjust. .env is git-ignored — never commit real secrets.

# ── Database ──
MYSQL_ROOT_PASSWORD=root
# Host port for MySQL (3307 so it does not clash with a local MySQL on 3306)
MYSQL_HOST_PORT=3307

# ── Backend ──
# Hospital time zone used for "today", slot times and the cancel/reschedule cutoff
APP_TIMEZONE=Asia/Kolkata
# Must be at least 32 characters (HS256 key size)
APP_JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
BACKEND_HOST_PORT=8080
# Browser origins allowed to call the API (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# ── Demo seed data (created only when the database has no users) ──
APP_SEED_ENABLED=true
APP_SEED_ADMIN_PASSWORD=Admin@123
APP_SEED_DEFAULT_PASSWORD=Welcome@123

# ── Frontend ──
FRONTEND_HOST_PORT=80
